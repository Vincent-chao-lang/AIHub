# AI Memory Hub 配置文件
# 复制此文件为 .env:  cp .env.example .env

# ── 数据库（二选一）──
# SQLite：默认，零配置（取消注释下面这行以自定义路径）
# DATABASE_URL=sqlite:///aihub.db
# PostgreSQL：取消注释并填写你的连接信息
# DATABASE_URL=postgresql://user:password@localhost:5432/aihub

# ── 向量索引（可选）──
# ChromaDB 存储目录，默认为 backend/.chromadb
# CHROMA_PATH=/data/aihub-vectors
