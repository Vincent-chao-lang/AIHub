# AI Memory Hub 配置文件
# 复制此文件为 .env:  cp .env.example .env

# ── 数据库（二选一）──
# SQLite：默认，零配置（取消注释下面这行以自定义路径）
# DATABASE_URL=sqlite:///aihub.db
# PostgreSQL：取消注释并填写你的连接信息
# DATABASE_URL=postgresql://user:password@localhost:5432/aihub

# ── 向量存储（二选一）──
# chromadb（默认）：零配置，本地持久化，pip install 即用
# VECTOR_STORE=chromadb
# pgvector：配合 PostgreSQL 使用，需先 CREATE EXTENSION vector
# VECTOR_STORE=pgvector

# ── 向量索引路径（仅 ChromaDB）──
# ChromaDB 存储目录，默认为 backend/.chromadb
# CHROMA_PATH=/data/aihub-vectors

# ── Embedding 方案 ──
# local（默认）：本地 sentence-transformers 模型
# openai：OpenAI text-embedding API
# EMBEDDING_PROVIDER=local
# 本地模型名 或 API 模型名
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 可选，仅 OpenAI text-embedding-3 系列支持指定维度
# EMBEDDING_DIM=
# EMBEDDING_PROVIDER=openai 时必须设置
# OPENAI_API_KEY=sk-xxx
# 可选，支持代理/中转
# OPENAI_BASE_URL=
