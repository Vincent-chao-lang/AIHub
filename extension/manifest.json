{
  "manifest_version": 3,
  "name": "AI Memory Hub",
  "version": "0.2.0",
  "description": "Personal AI OS — 跨平台 AI 长期记忆系统。自动记录、检索、关联你的所有 AI 对话。",
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://kimi.moonshot.cn/*",
    "https://chat.deepseek.com/*",
    "http://127.0.0.1:8712/*",
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "AI Memory Hub — 打开记忆侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["shared/types.js", "content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shared/types.js", "content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["shared/types.js", "content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://kimi.moonshot.cn/*"],
      "js": ["shared/types.js", "content/kimi.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["shared/types.js", "content/deepseek.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
